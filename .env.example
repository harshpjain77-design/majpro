# Platform Environment Variables Example
PLATFORM_ENV=development
LOG_LEVEL=INFO

# Ingestion API (Phase 2)
INGESTION_HOST=127.0.0.1
INGESTION_PORT=8000
INGESTION_API_KEY=test-collector-api-key-replace-in-production

# Storage (Phase 3)
DATABASE_URL=sqlite:///./output/soc_events.sqlite

# Collectors
COLLECTOR_CHECKPOINT_DIR=output/
COLLECTOR_OUTPUT_DIR=output/
